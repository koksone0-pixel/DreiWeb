<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>My Portfolio Website</title>
<style>
:root {
  --ink: #1b2a41;
  --paper: rgba(255,255,255,.93);
  --accent: #1e5fd8;
  --text: #2a2f3a;
  --bg1: #16264a;
  --bg2: #2b4a8c;
  --overlay: rgba(15,25,50,.55);
}
@media (prefers-color-scheme: dark) {
  :root {
    --ink: #e8eefc; --paper: rgba(20,28,48,.92); --accent: #7fb0ff; --text: #d6deef;
    --overlay: rgba(5,10,25,.65);
  }
}
html { scroll-behavior: smooth; }
*, *::before, *::after { box-sizing: border-box; }
body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  color: var(--text);
  line-height: 1.65;
  background-color: #16264a;
  background-image:
    url("https://i.postimg.cc/yN7V0GNK/IMG-20261031-022500.jpg"),
    linear-gradient(160deg, var(--bg1), var(--bg2));
  background-size: cover;
  background-position: center;
  background-attachment: fixed;
  min-height: 100vh;
}
body::before { content: ""; position: fixed; inset: 0; background: var(--overlay); z-index: -1; }

header {
  text-align: center;
  color: #fff;
  padding: 64px 20px 48px;
  background: rgba(30,58,95,.85);
  backdrop-filter: blur(6px);
}
header h1 { margin: 0; font-size: clamp(2rem, 8vw, 3.4rem); letter-spacing: .5px; }
.typing::after { content: "|"; margin-left: 4px; animation: blink .8s infinite; }
@keyframes blink { 50% { opacity: 0; } }

main { max-width: 820px; margin: 0 auto; padding: 24px 16px 40px; }
section {
  background: var(--paper);
  border-radius: 18px;
  padding: 26px 24px;
  margin: 22px 0;
  box-shadow: 0 8px 24px rgba(0,0,0,.25);
}
h2 { margin: 0 0 14px; color: var(--ink); font-size: 1.7rem; padding-bottom: 8px; border-bottom: 3px solid var(--accent); }
h3 { margin: 0 0 6px; color: var(--ink); font-size: 1.15rem; }
article { padding: 14px 0; border-top: 1px solid rgba(120,130,150,.3); }
article:first-of-type { border-top: 0; }
p { margin: 0 0 10px; max-width: 70ch; }

footer { text-align: center; color: #fff; padding: 22px 16px 36px; background: rgba(30,58,95,.85); font-size: .92rem; }
footer p { margin: 0 auto; }

.reveal { opacity: 0; transform: translateY(32px); transition: opacity .7s ease, transform .7s ease; }
.reveal.visible { opacity: 1; transform: none; }

#progress { position: fixed; top: 0; left: 0; height: 5px; width: 0; z-index: 99; background: linear-gradient(90deg, #00c6ff, #7c5cff, #ff5c9d); }
#top {
  position: fixed; right: 16px; bottom: 22px;
  width: 48px; height: 48px; border: 0; border-radius: 50%;
  background: var(--accent); color: #fff; font-size: 22px; cursor: pointer;
  box-shadow: 0 6px 16px rgba(0,0,0,.4);
  opacity: 0; pointer-events: none; transform: translateY(16px); transition: all .3s ease; z-index: 99;
}
#top.show { opacity: 1; pointer-events: auto; transform: none; }
#top:focus-visible { outline: 3px solid #fff; outline-offset: 2px; }

.acc-head { cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 12px; -webkit-tap-highlight-color: transparent; }
.acc-head::after { content: "+"; flex: none; width: 30px; height: 30px; line-height: 28px; text-align: center; border-radius: 50%; border: 2px solid var(--accent); color: var(--accent); font-size: 1.2rem; font-weight: bold; transition: transform .25s ease, background .25s ease, color .25s ease; }
.acc-head[aria-expanded="true"]::after { content: "\2212"; background: var(--accent); color: #fff; }
.acc-head:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; border-radius: 6px; }
.panel { padding-top: 10px; }
.sent { cursor: pointer; margin: 0 0 8px; padding: 8px 12px; max-width: 70ch; border-left: 4px solid var(--accent); background: rgba(120,140,190,.12); border-radius: 0 10px 10px 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; transition: background .2s ease; -webkit-tap-highlight-color: transparent; }
.sent[aria-expanded="true"] { white-space: normal; overflow: visible; text-overflow: clip; background: rgba(120,140,190,.24); }
.sent:focus-visible { outline: 3px solid var(--accent); outline-offset: 2px; }
.panel:not([hidden]) { animation: openPanel .3s ease; }
@keyframes openPanel { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }

@media (prefers-reduced-motion: reduce) {
  html { scroll-behavior: auto; }
  .panel { animation: none !important; }
  .reveal { opacity: 1; transform: none; transition: none; }
  .typing::after { animation: none; }
}
</style>
</head>
<body>

<header>
  <h1 id="title">MY PORTFOLIO WEBSITE</h1>
</header>

<main>
  <section id="introduction">
    <h2>Introduction</h2>
    <p>Good day everyone!</p>
    <p>My name is Jhon Andrei Tambilo.</p>
    <p>Today, I am going to present my Personal Website Portfolio. This website showcases my personal information, skills, educational background, projects, and contact details.</p>
  </section>

  <section id="skills-projects">
    <h2>Skills and Projects</h2>

    <article>
      <h3>Skills</h3>
      <p>Some of my skills include: HTML, CSS, JavaScript, Communication, Teamwork, and Time Management.</p>
    </article>

    <article>
      <h3>Projects</h3>
      <p>In the Projects section, I showcase my personal website portfolio and other activities or projects I have completed.</p>
    </article>

    <article>
      <h3>Education and Achievements</h3>
      <p>In this section, I present my educational background and achievements.</p>
      <p>I am continuously learning and improving my knowledge in Information Technology to prepare myself for future opportunities.</p>
    </article>

    <article>
      <h3>Contact</h3>
      <p>Next is the Contact section.</p>
      <p>This section allows visitors to see my contact information and gives them a way to reach me for questions, collaboration, or other opportunities.</p>
    </article>

    <article>
      <h3>Technical Demonstration</h3>
      <p>For my website development, I used three main technologies:</p>
      <p><strong>HTML</strong> – used to create the structure and content of my website.</p>
      <p><strong>CSS</strong> – used to design the layout, colors, fonts, and overall appearance.</p>
      <p><strong>JavaScript</strong> – used to add interactive features and functionality.</p>
      <p>These technologies work together to make my personal portfolio website.</p>
    </article>
  </section>

  <section id="conclusion">
    <h2>Conclusion</h2>
    <p>BSIT is a good course for students who are interested in computers and technology. It provides useful skills that can be applied in different IT careers.</p>
  </section>
</main>

<footer>
  <p>&copy; 2026 IT Course Guide - Tambilo, Jhon Andrei D. - OLCA211E053</p>
</footer>

<div id="progress"></div>
<button id="top" aria-label="Back to top">&#8593;</button>

<script>
document.addEventListener("DOMContentLoaded", function () {
  var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Progress bar + back to top
  var bar = document.getElementById("progress");
  var topBtn = document.getElementById("top");
  topBtn.addEventListener("click", function () { window.scrollTo({ top: 0, behavior: "smooth" }); });
  window.addEventListener("scroll", function () {
    var max = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.width = (max > 0 ? (window.scrollY / max) * 100 : 0) + "%";
    topBtn.classList.toggle("show", window.scrollY > 300);
  });

  // Typing effect on the title
  var title = document.getElementById("title");
  if (title && !reduce) {
    var full = title.textContent.trim();
    title.textContent = "";
    title.classList.add("typing");
    var i = 0;
    (function type() {
      if (i < full.length) {
        title.textContent += full.charAt(i++);
        setTimeout(type, 80);
      } else {
        setTimeout(function () { title.classList.remove("typing"); }, 1500);
      }
    })();
  }

  // Click to open: each heading opens or closes its text
  function makeAccordion(head) {
    var parent = head.parentNode;
    var panel = document.createElement("div");
    panel.className = "panel";
    panel.hidden = true;
    while (head.nextSibling) { panel.appendChild(head.nextSibling); }
    parent.appendChild(panel);
    head.classList.add("acc-head");
    head.setAttribute("role", "button");
    head.setAttribute("tabindex", "0");
    head.setAttribute("aria-expanded", "false");
    function toggle() {
      var open = head.getAttribute("aria-expanded") === "true";
      head.setAttribute("aria-expanded", open ? "false" : "true");
      panel.hidden = open;
    }
    head.addEventListener("click", toggle);
    head.addEventListener("keydown", function (e) {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); toggle(); }
    });
  }
  document.querySelectorAll("#introduction h2, #conclusion h2, article h3").forEach(makeAccordion);

  // Click to open: each sentence opens on its own
  function makeSentence(el) {
    el.classList.add("sent");
    el.setAttribute("role", "button");
    el.setAttribute("tabindex", "0");
    el.setAttribute("aria-expanded", "false");
    function flip() {
      el.setAttribute("aria-expanded", el.getAttribute("aria-expanded") === "true" ? "false" : "true");
    }
    el.addEventListener("click", flip);
    el.addEventListener("keydown", function (e) {
      if (e.key === "Enter" || e.key === " ") { e.preventDefault(); flip(); }
    });
  }
  document.querySelectorAll(".panel p").forEach(function (p) {
    var parts = p.textContent.match(/[^.!?]+[.!?]+["')]*\s*|[^.!?]+$/g) || [];
    if (p.children.length || parts.length < 2) { makeSentence(p); return; }
    parts.forEach(function (txt) {
      var d = document.createElement("div");
      d.textContent = txt.trim();
      p.parentNode.insertBefore(d, p);
      makeSentence(d);
    });
    p.remove();
  });

  // Reveal sections on scroll
  var items = document.querySelectorAll("main section, footer");
  if ("IntersectionObserver" in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add("visible"); io.unobserve(e.target); }
      });
    }, { threshold: 0.1 });
    items.forEach(function (el) { el.classList.add("reveal"); io.observe(el); });
  }
});
</script>
</body>
</html>
